{VERSION=2.14}
{UNITS=ENGLISH LENGTH}

{BOARD "synthetic.kicad_pcb"
(PERIMETER_SEGMENT X1=1.000000000 Y1=-1.000000000 X2=3.000000000 Y2=-1.000000000)
(PERIMETER_SEGMENT X1=3.000000000 Y1=-1.000000000 X2=3.000000000 Y2=-2.000000000)
(PERIMETER_SEGMENT X1=3.000000000 Y1=-2.000000000 X2=1.000000000 Y2=-2.000000000)
(PERIMETER_SEGMENT X1=1.000000000 Y1=-2.000000000 X2=1.000000000 Y2=-1.000000000)
}

{STACKUP
(SIGNAL T=0.035 P=0 C=5.8e+07 L="F.Cu" M=COPPER)
(DIELECTRIC T=1.51 C=4.5 L="DE_F.Cu" M="FR4")
(SIGNAL T=0.035 P=0 C=5.8e+07 L="B.Cu" M=COPPER)
}

{DEVICES
(? REF="U1" L="F.Cu")
(? REF="R1" L="F.Cu")
(? REF="C1" L="B.Cu")
}

{PADSTACK=1
("F.Cu", 1, 0.0393700787, 0.0590551181, 0.0, M)
}
{PADSTACK=2
("B.Cu", 1, 0.0590551181, 0.0590551181, 0.0, M)
}
{PADSTACK=3, 0.0314960630
("MDEF", 0, 0.0590551181, 0.0590551181, 0.0, M)
}

{NET="GND"
(PIN X=1.2000000000 Y=-1.3000000000 R="U1.1" P=1)
(PIN X=1.4000000000 Y=-1.3000000000 R="U1.2" P=1)
(PIN X=2.5000000000 Y=-1.5000000000 R="C1.2" P=2)
(PIN X=2.8000000000 Y=-1.2000000000 R="J1.1" P=3)
(SEG X1=1.2000000000 Y1=-1.3000000000 X2=1.4000000000 Y2=-1.3000000000 W=0.0100000000 L="F.Cu")
(VIA X=1.7000000000 Y=-1.3000000000 P=3)
}
{NET="Net-(R1-Pad1)"
(PIN X=1.6000000000 Y=-1.7000000000 R="R1.1" P=1)
(PIN X=1.2000000000 Y=-1.5000000000 R="U1.3" P=1)
}
{END}
